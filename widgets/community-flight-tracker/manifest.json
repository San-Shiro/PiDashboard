{
  "id": "community-flight-tracker",
  "name": "Live Flight Tracker",
  "version": "1.0.0",
  "description": "Real-time ADS-B flight tracking using OpenSky Network.",
  "author": "Community",
  "tier": "pull",
  "trust": "community",
  "dataChannel": {
    "fetchModule": "fetch.js"
  },
  "polling": {
    "intervalSec": 30,
    "jitterSec": 5
  },
  "entrypoints": {
    "fragment": "flight.html"
  },
  "configSchema": [
    {
      "key": "latitude",
      "type": "number",
      "label": "Center Latitude",
      "default": 40.7128,
      "min": -90,
      "max": 90
    },
    {
      "key": "longitude",
      "type": "number",
      "label": "Center Longitude",
      "default": -74.0060,
      "min": -180,
      "max": 180
    },
    {
      "key": "radiusKm",
      "type": "number",
      "label": "Search Radius (km)",
      "default": 100,
      "min": 10,
      "max": 500
    },
    {
      "key": "mapTheme",
      "type": "select",
      "label": "Map Theme",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark Mode" },
        { "value": "light", "label": "Light Mode" }
      ]
    },
    {
      "key": "zoom",
      "type": "number",
      "label": "Initial Zoom",
      "default": 8,
      "min": 1,
      "max": 18
    }
  ]
}
