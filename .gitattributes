# Normalize text files in the repository, but force LF in the WORKING TREE for
# everything that is executed by a Unix shell.
#
# Without this, core.autocrlf=true on a Windows dev machine writes CRLF into the
# working tree. The deploy script tars the working tree, so the Pi receives
# scripts whose shebang reads "#!/bin/bash\r" — Linux then looks for an
# interpreter literally named "/bin/bash\r" and every daemon dies with exit 127
# (or 126). Keep these LF everywhere.

* text=auto

*.sh    text eol=lf
*.bash  text eol=lf

# Files read or executed on the Pi
daemons/**      text eol=lf
scripts/**      text eol=lf
deploy/*.sh     text eol=lf

# Binary assets — never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.mp3   binary
*.wav   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.b64   binary
*.wig   binary
*.tar.gz binary
